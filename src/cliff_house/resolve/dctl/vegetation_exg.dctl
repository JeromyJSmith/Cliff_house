// Excess Green (ExG) = 2g − r − b on chromatic coordinates r = R/(R+G+B) etc., on display-referred Rec.709 values
// (relative vegetation layer for site review, never reconstruction).
// Output: grey, (ExG + 1) / 3 clamped to 0..1 (ExG spans −1..2), so ~0.33 = neutral grey, brighter = greener.
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float s = p_R + p_G + p_B;
    float o = 1.0f / 3.0f;
    if (s > 1e-4f) {
        float exg = (2.0f * p_G - p_R - p_B) / s;
        o = _clampf((exg + 1.0f) / 3.0f, 0.0f, 1.0f);
    }
    return make_float3(o, o, o);
}
